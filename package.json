{
  "name": "the-hidden-label",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:status": "node scripts/dev-db.mjs status",
    "db:migrate": "pnpm --filter @thl/backend exec medusa db:migrate",
    "db:seed": "pnpm --filter @thl/backend exec medusa exec ./src/scripts/seed.ts",
    "db:setup-tax": "pnpm --filter @thl/backend exec medusa exec ./src/scripts/setup-tax.ts",
    "db:setup-payments": "pnpm --filter @thl/backend exec medusa exec ./src/scripts/setup-payments.ts",
    "dev:backend": "pnpm --filter @thl/backend dev",
    "dev:admin": "pnpm --filter @thl/admin dev",
    "dev:storefront": "pnpm --filter @thl/storefront dev",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --no-bail test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-arm64"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@eslint/js": "9.39.5",
    "@thl/config": "workspace:*",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.4"
  }
}
