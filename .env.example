# =============================================================================
# THE HIDDEN LABEL — environment template
# Copy to `.env` for local development. Never commit a filled .env.
# Production values live in the host's secret store, not in the repository.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Matches docker-compose.yml (port 5433) and the portable cluster from `pnpm db:start`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5437/the_hidden_label
# Fallback only for hosts where native PostgreSQL cannot fork: the in-process WASM server
# (node scripts/dev-db-wasm.mjs, port 5435). It accepts a single connection, which is not
# enough for Medusa's pool — use it for inspection, not for migrations.
# DATABASE_URL=postgres://postgres:postgres@localhost:5435/postgres
# Optional separate shadow/audit database; leave empty to reuse DATABASE_URL.
DATABASE_SHADOW_URL=

# --- Cache / queues -----------------------------------------------------------
# docker-compose maps Redis to 6380. Format: redis://[:password@]host:port
REDIS_URL=redis://localhost:6380

# --- Backend (Medusa) ---------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local dev values only — production must be distinct and stored as secrets.
MEDUSA_JWT_SECRET=local_dev_jwt_secret_change_me_0123456789abcdef
MEDUSA_COOKIE_SECRET=local_dev_cookie_secret_change_me_0123456789abcdef
MEDUSA_ADMIN_ONBOARDING=false
# Set by `pnpm db:seed`; the storefront sends it as x-publishable-api-key.
MEDUSA_PUBLISHABLE_KEY=

# --- Storefront ---------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
# Must be an absolute origin for server-side fetches; kept separate from the
# public one so a container network can reach the backend internally.
MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resale/AI layer rollout gates (decision D7 — now IN SCOPE for v1, built as Phase 5.5) ---
# D1 originally deferred this to V2; D7 reversed that (client confirmed CultureCircle-style
# resale/authentication marketplace is the actual requirement). Each flag still defaults false
# and flips on only once its backing data model + workflow is actually built and tested —
# never render the UI ahead of real data (see docs/SCREEN_MAP.md §3, docs/PROJECT_PLAN.md D7).
NEXT_PUBLIC_FEATURE_AI_LAYER=false
NEXT_PUBLIC_FEATURE_INSPECTION=false
NEXT_PUBLIC_FEATURE_FIT_STUDIO=false
NEXT_PUBLIC_FEATURE_BIDDING=false

# --- Razorpay (Phase 6) -------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (Phase 6) -----------------------------------------------------
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_WEBHOOK_TOKEN=
# SHIPROCKET_PICKUP_LOCATION=

# --- Transactional email / OTP (Phase 6) --------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM="orders@thehiddenlabel.com"
# OTP_PROVIDER=msg91
# OTP_API_KEY=
# OTP_SENDER_ID=

# --- Gemini (Phase 5.5 — AI-01 Search by Sight, AI-05 Style Concierge) --------
# Free key at https://aistudio.google.com/apikey (verify current free-tier terms before relying
# on it for real traffic). Both AI-01 and AI-05 stay honest fallbacks without this — see
# apps/backend/src/lib/gemini.ts and docs/MASTER_PLAN.md §2.4. Also requires
# NEXT_PUBLIC_FEATURE_AI_LAYER=true in apps/storefront's env to actually show the UI.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Image storage (Phase 6) --------------------------------------------------
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# --- Observability ------------------------------------------------------------
# SENTRY_DSN=
LOG_LEVEL=info
