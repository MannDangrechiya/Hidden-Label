# =============================================================================
# THE HIDDEN LABEL — environment template
# Copy to `.env` for local development. Never commit a filled .env.
# Production values live in the host's secret store, not in the repository.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Matches docker-compose.yml (port 5433) and the portable cluster from `pnpm db:start`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5437/the_hidden_label
# Fallback only for hosts where native PostgreSQL cannot fork: the in-process WASM server
# (node scripts/dev-db-wasm.mjs, port 5435). It accepts a single connection, which is not
# enough for Medusa's pool — use it for inspection, not for migrations.
# DATABASE_URL=postgres://postgres:postgres@localhost:5435/postgres
# Optional separate shadow/audit database; leave empty to reuse DATABASE_URL.
DATABASE_SHADOW_URL=
# Per-process Postgres pool. Each backend replica opens its own pool of this size, so
# DB_POOL_MAX * replica count must stay comfortably under Postgres's own max_connections.
# DB_POOL_MIN=2
# DB_POOL_MAX=20

# --- Cache / queues -----------------------------------------------------------
# docker-compose maps Redis to 6380. Format: redis://[:password@]host:port
REDIS_URL=redis://localhost:6380

# --- Backend (Medusa) ---------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local dev values only — production must be distinct and stored as secrets.
MEDUSA_JWT_SECRET=local_dev_jwt_secret_change_me_0123456789abcdef
MEDUSA_COOKIE_SECRET=local_dev_cookie_secret_change_me_0123456789abcdef
MEDUSA_ADMIN_ONBOARDING=false
# Set by `pnpm db:seed`; the storefront sends it as x-publishable-api-key.
MEDUSA_PUBLISHABLE_KEY=

# --- Storefront ---------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
# Must be an absolute origin for server-side fetches; kept separate from the
# public one so a container network can reach the backend internally.
MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resale/AI layer rollout gates (decision D7 — now IN SCOPE for v1, built as Phase 5.5) ---
# D1 originally deferred this to V2; D7 reversed that (client confirmed CultureCircle-style
# resale/authentication marketplace is the actual requirement). Each flag still defaults false
# and flips on only once its backing data model + workflow is actually built and tested —
# never render the UI ahead of real data (see docs/SCREEN_MAP.md §3, docs/PROJECT_PLAN.md D7).
NEXT_PUBLIC_FEATURE_AI_LAYER=false
NEXT_PUBLIC_FEATURE_INSPECTION=false
NEXT_PUBLIC_FEATURE_FIT_STUDIO=false
NEXT_PUBLIC_FEATURE_BIDDING=false

# --- Razorpay -----------------------------------------------------------------
# The backend needs both keys. The storefront needs the PUBLIC key id only (this is the value
# checkout.js expects; it is not a secret). With all three set, the seed links
# pp_razorpay_razorpay to the India region and the checkout offers UPI / cards / EMI.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Shiprocket (Phase 6) -----------------------------------------------------
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_WEBHOOK_TOKEN=
# SHIPROCKET_PICKUP_LOCATION=

# --- Transactional email ------------------------------------------------------
# Without a key, mail is logged (never silently dropped) and order flows still complete.
# RESEND_API_KEY=
# EMAIL_FROM="orders@thehiddenlabel.com"
# MF-28: who receives the scheduled daily orders-report email (src/jobs/emailed-reports.ts).
# Unset = the job is a no-op.
# REPORTS_EMAIL=ops@thehiddenlabel.com

# --- SMS OTP (India: DLT registration is mandatory) ---------------------------
# OTP_PROVIDER=msg91 | twilio
# MSG91: auth key + the DLT-approved OTP content template id and sender header.
# OTP_PROVIDER=msg91
# OTP_API_KEY=
# OTP_TEMPLATE_ID=
# OTP_SENDER_ID=THLBL
# Twilio alternative:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Local development only: echoes the code in the API response. Never enable in production.
# OTP_DEV_ECHO=true

# --- WhatsApp order notifications (optional, alongside email) ----------------
# MSG91's WhatsApp API — the business already holds an MSG91 account for SMS above. Each
# template name must be pre-approved on the MSG91 WhatsApp dashboard before it will send.
# MSG91_WHATSAPP_AUTH_KEY=
# MSG91_WHATSAPP_INTEGRATED_NUMBER=
# WHATSAPP_TEMPLATE_ORDER_PLACED=thl_order_placed
# WHATSAPP_TEMPLATE_ORDER_CANCELED=thl_order_canceled
# WHATSAPP_TEMPLATE_ORDER_SHIPPED=thl_order_shipped
# WHATSAPP_TEMPLATE_ORDER_DELIVERED=thl_order_delivered

# --- Business identity (GST invoice + Legal Metrology) ------------------------
# GAP-TAX-03: the invoice prints these instead of a dummy GSTIN. State code 24 = Gujarat:
# intra-state supplies split CGST+SGST, every other destination is charged IGST.
# BUSINESS_GSTIN=
# BUSINESS_LEGAL_NAME="The Hidden Label Luxury Retail Pvt Ltd"
# BUSINESS_STATE_CODE=24
# BUSINESS_STATE_NAME=Gujarat
# BUSINESS_ADDRESS="Steller, 205, 2nd Floor, Sindhu Bhavan Road, Bodakdev, Ahmedabad, Gujarat 380059"

# --- Consumer protection / DPDP ----------------------------------------------
# GAP-SUP-02: published on /policies/grievance and in the footer on every page.
# GRIEVANCE_OFFICER_NAME=
# GRIEVANCE_OFFICER_EMAIL=grievance@thehiddenlabel.com
# GRIEVANCE_OFFICER_PHONE=
# GRIEVANCE_OFFICER_ADDRESS=
# GRIEVANCE_OFFICER_HOURS="Monday to Saturday, 10:00–19:00 IST"
# SUPPORT_EMAIL=concierge@thehiddenlabel.com
# SUPPORT_PHONE=

# --- Gemini (Phase 5.5 — AI-01 Search by Sight, AI-05 Style Concierge) --------
# Free key at https://aistudio.google.com/apikey (verify current free-tier terms before relying
# on it for real traffic). Both AI-01 and AI-05 stay honest fallbacks without this — see
# apps/backend/src/lib/gemini.ts and docs/MASTER_PLAN.md §2.4. Also requires
# NEXT_PUBLIC_FEATURE_AI_LAYER=true in apps/storefront's env to actually show the UI.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Image storage (Phase 6) --------------------------------------------------
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# --- Observability ------------------------------------------------------------
# SENTRY_DSN=
LOG_LEVEL=info
