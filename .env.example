# Razorpay API endpoint. Leave empty for production (defaults to https://api.razorpay.com).
# For local development with placeholder keys, point it at the sandbox emulator that ships
# with the repo and emulates the v1 API contract: RAZORPAY_API_URL=http://127.0.0.1:9099
# (start it with `pnpm dev:sandbox` from the repo root). Real keys must use api.razorpay.com.
RAZORPAY_API_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REDIS_PASSWORD=
REDIS_URL=
REPORTS_EMAIL=
RESEND_API_KEY=
RETURN_WINDOW_DAYS=
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_REGION=
S3_SECRET_ACCESS_KEY=
# Shiprocket credentials. In development (NODE_ENV != production) without SHIPROCKET_BASE_URL
# and without credentials, defaults route to the local sandbox emulator at
# http://127.0.0.1:9098/v1/external with placeholder credentials. For the real API set
# SHIPROCKET_BASE_URL to https://apiv2.shiprocket.in/v1/external with live credentials.
# The sandbox emulator is part of the same `pnpm dev:sandbox` script as the Razorpay port
# (Razorpay on :9099, Shiprocket on :9098).
SHIPROCKET_BASE_URL=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=
STOREFRONT_DOMAIN=
STOREFRONT_ORIGIN=
SUPPORT_EMAIL=
SUPPORT_PHONE=
THL_RESALE_COMMISSION_RATE=
