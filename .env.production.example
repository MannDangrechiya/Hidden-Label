# =============================================================================
# THE HIDDEN LABEL — Infrastructure & Docker Compose Environment Template
# Location: .env.production.example (Workspace Root)
# =============================================================================
# Copy this template to .env.production in the root directory for Docker Compose
# variable interpolation (postgres and redis container initialization), then run
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# IMPORTANT ARCHITECTURAL NOTE:
# The Hidden Label enforces strict service isolation. Application containers load
# their own dedicated environment files from:
#   - apps/backend/.env.production     <- (from apps/backend/.env.production.example)
#   - apps/storefront/.env.production  <- (from apps/storefront/.env.production.example)
#   - apps/admin/.env.production       <- (from apps/admin/.env.production.example)
#
# NEVER copy backend database or payment secrets into storefront or admin containers.
# NEVER commit production credentials or keys to the git repository.
# =============================================================================

# --- Docker Compose Infrastructure Interpolation -----------------------------
# These variables configure the PostgreSQL and Redis containers in docker-compose.prod.yml.

# PostgreSQL 18
POSTGRES_USER=thl_prod_user
POSTGRES_PASSWORD=PROD_STRONG_DATABASE_PASSWORD_MIN_32_CHARS
POSTGRES_DB=the_hidden_label

# Redis 7
REDIS_PASSWORD=PROD_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# --- Service Ports & Domains (Reverse Proxy Routing) -------------------------
STOREFRONT_DOMAIN=thehiddenlabel.com
BACKEND_DOMAIN=api.thehiddenlabel.com
ADMIN_DOMAIN=admin.thehiddenlabel.com

# =============================================================================
# APPLICATION SERVICE TEMPLATES DIRECTORY:
# =============================================================================
# 1. Backend:    apps/backend/.env.production.example
#    Contains:   DATABASE_URL, REDIS_URL, MEDUSA_JWT_SECRET, RAZORPAY_KEY_SECRET,
#                SHIPROCKET_PASSWORD, RESEND_API_KEY, S3 credentials, OTP keys.
#
# 2. Storefront: apps/storefront/.env.production.example
#    Contains:   MEDUSA_URL, NEXT_PUBLIC_MEDUSA_URL, NEXT_PUBLIC_RAZORPAY_KEY_ID,
#                feature flags, statutory and consumer protection disclosures.
#
# 3. Admin:      apps/admin/.env.production.example
#    Contains:   BACKEND_URL, NEXT_PUBLIC_MEDUSA_BACKEND_URL, ADMIN_SESSION_COOKIE.
# =============================================================================
