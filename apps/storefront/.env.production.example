# =============================================================================
# THE HIDDEN LABEL — Storefront Production Environment Template
# Location: apps/storefront/.env.production.example
# =============================================================================
# Copy this template to apps/storefront/.env.production on deployment.
# This file contains ONLY variables required by the Next.js storefront.
# NO DATABASE, REDIS, PAYMENT SECRETS, OR BACKEND KEYS ARE PRESENT HERE.
# =============================================================================

# --- Node Environment & Server -----------------------------------------------
NODE_ENV=production
PORT=3000

# --- Backend Connections -----------------------------------------------------
# Server-side calls from Next.js server components use internal Docker network:
MEDUSA_URL=http://backend:9000
# Client-side browser calls use the public reverse proxy URL:
NEXT_PUBLIC_MEDUSA_URL=https://api.thehiddenlabel.com

# --- Medusa Publishable API Key (Public Client Token) ------------------------
MEDUSA_PUBLISHABLE_KEY=pk_prod_publishable_api_key_from_seed
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_prod_publishable_api_key_from_seed

# --- Razorpay Public Key (Required for client-side checkout modal) -----------
# Note: NEVER put RAZORPAY_KEY_SECRET here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_PROD_KEY_ID

# --- Feature Flags -----------------------------------------------------------
# Bidding is disabled by default for Phase 1 / V1 launch.
NEXT_PUBLIC_FEATURE_BIDDING=false
NEXT_PUBLIC_FEATURE_AI_LAYER=false
NEXT_PUBLIC_CONSIGNMENT_COMMISSION_RATE=

# --- Media & Image CDN -------------------------------------------------------
S3_PUBLIC_BASE_URL=https://cdn.thehiddenlabel.com
NEXT_PUBLIC_IMAGE_HOSTS=cdn.thehiddenlabel.com,thehiddenlabel.com,api.thehiddenlabel.com

# --- Indian Statutory Business Identity (Footer & Disclosures) ---------------
BUSINESS_LEGAL_NAME=The Hidden Label Luxury Retail Pvt Ltd
BUSINESS_GSTIN=24AABCT0000A1Z5
BUSINESS_CIN=U52100GJ2024PTC123456
BUSINESS_STATE_CODE=24
BUSINESS_STATE_NAME=Gujarat
BUSINESS_ADDRESS=Steller, 205, 2nd Floor, Sindhu Bhavan Road, Bodakdev, Ahmedabad, Gujarat 380059

# --- Consumer Protection & DPDP Grievance Officer ----------------------------
GRIEVANCE_OFFICER_NAME=Grievance Officer
GRIEVANCE_OFFICER_EMAIL=grievance@thehiddenlabel.com
GRIEVANCE_OFFICER_PHONE=+917900000000
GRIEVANCE_OFFICER_ADDRESS=Steller, 205, 2nd Floor, Sindhu Bhavan Road, Bodakdev, Ahmedabad, Gujarat 380059
GRIEVANCE_OFFICER_HOURS=Monday to Saturday, 10:00–19:00 IST
SUPPORT_EMAIL=concierge@thehiddenlabel.com
SUPPORT_PHONE=+917900000000
