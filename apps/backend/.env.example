# THE HIDDEN LABEL — Backend Local Development Environment Template
# Copy this to apps/backend/.env

DATABASE_URL=postgres://postgres@127.0.0.1:5437/the_hidden_label
# REDIS_URL=redis://localhost:6380

MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:7001
MEDUSA_JWT_SECRET=local_dev_jwt_secret_change_me_0123456789abcdef
MEDUSA_COOKIE_SECRET=local_dev_cookie_secret_change_me_0123456789abcdef
LOG_LEVEL=info

PORT=9000

# OTP local echo
OTP_DEV_ECHO=true

# Razorpay Sandbox
RAZORPAY_KEY_ID=rzp_test_thl_sandbox
RAZORPAY_KEY_SECRET=secret_thl_sandbox_key_999
RAZORPAY_WEBHOOK_SECRET=secret_thl_webhook_999

# Return Policy
RETURN_WINDOW_DAYS=7

# Resale / consignment rollout gate. Resale, consignment and inspection endpoints answer 404
# unless this is "true". Enable it together with the storefront/admin NEXT_PUBLIC_ENABLE_RESALE.
ENABLE_RESALE=false

# Business Identity
BUSINESS_GSTIN=24AABCT0000A1Z5
BUSINESS_LEGAL_NAME=The Hidden Label Luxury Retail Pvt Ltd
BUSINESS_CIN=
BUSINESS_STATE_CODE=24
BUSINESS_STATE_NAME=Gujarat
BUSINESS_ADDRESS=Steller, 205, 2nd Floor, Sindhu Bhavan Road, Bodakdev, Ahmedabad, Gujarat 380059

# Local Razorpay sandbox emulator (scripts/sandbox-service.mjs, `pnpm dev:sandbox`).
# Only needed when RAZORPAY_KEY_ID is the dev placeholder — with placeholder keys the module
# automatically routes to http://127.0.0.1:9099. Set RAZORPAY_API_URL to override explicitly.
# RAZORPAY_API_URL=http://127.0.0.1:9099
