# =============================================================================
# THE HIDDEN LABEL — Backend Production Environment Template
# Location: apps/backend/.env.production.example
# =============================================================================
# Copy this template to apps/backend/.env.production on deployment.
# NEVER commit production secrets or live credentials to git.
# =============================================================================

# --- Node Environment & Server -----------------------------------------------
NODE_ENV=production
PORT=9000
LOG_LEVEL=info

# --- Database (PostgreSQL 18) ------------------------------------------------
# When using Docker Compose internal network: host is "postgres" port 5432.
# When using managed cloud DB (AWS RDS / GCP Cloud SQL), replace host and enable SSL.
DATABASE_URL=postgres://thl_prod_user:PROD_STRONG_PASSWORD@postgres:5432/the_hidden_label
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- Cache & Message Broker (Redis 7) ----------------------------------------
# When using Docker Compose internal network: host is "redis" port 6379.
REDIS_URL=redis://:PROD_REDIS_PASSWORD@redis:6379

# --- Backend Security Keys ---------------------------------------------------
# Must be >= 32 characters, random hex. MEDUSA_JWT_SECRET and MEDUSA_COOKIE_SECRET must differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDUSA_JWT_SECRET=PROD_RANDOM_JWT_SECRET_HEX_32_BYTES_MINIMUM
MEDUSA_COOKIE_SECRET=PROD_RANDOM_COOKIE_SECRET_HEX_32_BYTES_MINIMUM
MEDUSA_ADMIN_ONBOARDING=false
MEDUSA_BACKEND_URL=https://api.thehiddenlabel.com
MEDUSA_PUBLISHABLE_KEY=pk_prod_publishable_api_key_from_seed

# --- CORS Allowed Origins ----------------------------------------------------
STOREFRONT_ORIGIN=https://thehiddenlabel.com
ADMIN_ORIGIN=https://admin.thehiddenlabel.com

# --- Razorpay Production Payment Gateway (Private Merchant Secrets) ----------
# Merchant credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_PROD_KEY_ID
RAZORPAY_KEY_SECRET=PROD_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=PROD_RAZORPAY_WEBHOOK_SECRET

# --- Shiprocket Production Logistics (Private Merchant Credentials) ----------
# Merchant credentials from https://app.shiprocket.in/
SHIPROCKET_EMAIL=operations@thehiddenlabel.com
SHIPROCKET_PASSWORD=PROD_SHIPROCKET_PASSWORD
SHIPROCKET_WEBHOOK_TOKEN=PROD_STRONG_WEBHOOK_TOKEN_32_CHARS
SHIPROCKET_PICKUP_LOCATION=WH_AHMEDABAD_HQ

# --- Indian Statutory Business Identity (GST & Invoicing) --------------------
# Gujarat State Code = 24. Required for compliant B2C GST Tax Invoices.
BUSINESS_GSTIN=24AABCT0000A1Z5
BUSINESS_LEGAL_NAME=The Hidden Label Luxury Retail Pvt Ltd
BUSINESS_STATE_CODE=24
BUSINESS_STATE_NAME=Gujarat
BUSINESS_ADDRESS=Steller, 205, 2nd Floor, Sindhu Bhavan Road, Bodakdev, Ahmedabad, Gujarat 380059

# --- Transactional Communications (Resend API) -------------------------------
RESEND_API_KEY=re_prod_resend_api_key
EMAIL_FROM=orders@thehiddenlabel.com
REPORTS_EMAIL=ops@thehiddenlabel.com

# --- SMS OTP (DLT Registered - MSG91) ----------------------------------------
OTP_PROVIDER=msg91
OTP_API_KEY=PROD_MSG91_AUTH_KEY
OTP_TEMPLATE_ID=PROD_DLT_TE_ID_110716
OTP_SENDER_ID=THLBL
OTP_DEV_ECHO=false

# --- WhatsApp Notifications (MSG91 WhatsApp API) -----------------------------
MSG91_WHATSAPP_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
WHATSAPP_TEMPLATE_ORDER_PLACED=thl_order_placed
WHATSAPP_TEMPLATE_ORDER_CANCELED=thl_order_canceled
WHATSAPP_TEMPLATE_ORDER_SHIPPED=thl_order_shipped
WHATSAPP_TEMPLATE_ORDER_DELIVERED=thl_order_delivered

# --- Cloud Object Storage (S3 / Cloudflare R2 - Private Credentials) ----------
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=the-hidden-label-media-prod
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=PROD_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=PROD_S3_SECRET_KEY
S3_PUBLIC_BASE_URL=https://cdn.thehiddenlabel.com

# --- AI & Visual Intelligence (Gemini Studio - Private Key) ------------------
GEMINI_API_KEY=PROD_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# --- Consignment Resale Commission Policy -----------------------------------
# Owner-approved rate (e.g. 0.095 or 0.12). Leave empty for unconfigured safe default.
THL_RESALE_COMMISSION_RATE=
