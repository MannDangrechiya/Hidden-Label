# =============================================================================
# THE HIDDEN LABEL — Admin Dashboard Production Environment Template
# Location: apps/admin/.env.production.example
# =============================================================================
# Copy this template to apps/admin/.env.production on deployment.
# This file contains ONLY variables required by the Next.js admin dashboard.
# NO DATABASE, REDIS, PAYMENT SECRETS, OR BACKEND KEYS ARE PRESENT HERE.
# =============================================================================

# --- Node Environment & Server -----------------------------------------------
NODE_ENV=production
PORT=7001

# --- Backend Connection ------------------------------------------------------
# Internal Docker network proxy call to backend:
BACKEND_URL=http://backend:9000
# Browser-facing Medusa API URL:
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.thehiddenlabel.com

# --- Session & Security ------------------------------------------------------
ADMIN_SESSION_COOKIE=thl_admin_token
NEXT_PUBLIC_ADMIN_URL=https://admin.thehiddenlabel.com

# --- Feature Flags -----------------------------------------------------------
# Resale & Consignment (Disabled by default per launch decision):
NEXT_PUBLIC_ENABLE_RESALE=false
