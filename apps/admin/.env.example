# THE HIDDEN LABEL — admin app environment
#
# The admin app never talks to the backend from the browser. Every backend call is made
# server-side (Server Components, Server Actions, Route Handlers) and the session token is kept
# in an httpOnly cookie — never in localStorage, never shipped to the client bundle.

# Base URL of the Medusa backend (apps/backend). Server-side only.
BACKEND_URL=http://localhost:9000

# Name of the httpOnly cookie this app sets after a successful admin login.
ADMIN_SESSION_COOKIE=thl_admin_token

# Feature flags
NEXT_PUBLIC_ENABLE_RESALE=false
